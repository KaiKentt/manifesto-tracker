# Copy this file to .env.local and fill in the values.
# The setup script (scripts/setup.sh or scripts/setup.ps1) does this for you.

# ── Supabase (Project Settings → API Keys) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...). Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...). Server only — never expose it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ── Site ───────────────────────────────────────────────────────────
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe (test mode keys are fine for the prototype) ─────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price ID of the recurring "Wakil" plan, e.g. RM 49 / month
STRIPE_PRICE_ID=price_xxx

# ── Demo mode ──────────────────────────────────────────────────────
# true  = politician upgrade skips payment (for testing without Stripe)
# false = real Stripe Checkout. Always false in production.
DEMO_MODE=true
